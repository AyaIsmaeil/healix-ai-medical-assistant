{
  "schema_version": "assessment-features-v1",
  "description": "عقد الترميز الثابت بين ClinicalFeatureSet وEncodedFeatures (Phase 3.3). أي تغيير بمنطق الترميز (حقل جديد، فئة جديدة، ترتيب مختلف) يتطلّب نسخة جديدة (v2.json) — لا تعديل هذا الملف ولا استبدال FeatureEncoder.",

  "feature_order": [
    "age",
    "gender_male",
    "gender_female",
    "severity",
    "smoking",
    "temperature_c",
    "progression_worsening",
    "progression_stable",
    "progression_improving"
  ],

  "numeric_fields": {
    "age": {
      "source": "demographics.age",
      "nullable": true
    },
    "severity": {
      "source": "derived.primary_symptom_severity",
      "nullable": true
    },
    "temperature_c": {
      "source": "temperature_c",
      "nullable": true
    }
  },

  "boolean_fields": {
    "smoking": {
      "source": "lifestyle.smoking",
      "nullable": true
    }
  },

  "categorical_fields": {
    "gender": {
      "source": "demographics.gender",
      "values": ["male", "female"],
      "one_hot_prefix": "gender",
      "nullable": true
    },
    "progression": {
      "source": "primary_symptom.descriptors.progression",
      "values": ["worsening", "stable", "improving"],
      "one_hot_prefix": "progression",
      "nullable": true
    }
  },

  "nullable_fields": [
    "age",
    "severity",
    "temperature_c",
    "smoking",
    "gender",
    "progression"
  ]
}
