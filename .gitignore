# ============================================
# Healix - Git Ignore
# ============================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# Virtual Environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files
data/*.csv
data/*.xlsx
data/*.json
!data/category_info.json
app/data/**/*.csv
app/data/**/*.xlsx
app/data/**/*.json
app/data/**/*.m4a
!app/data/category_info.json

# Model files (local weight artifacts must never enter git)
models/*.bin
models/*.pt
*.safetensors

# ML pipeline (DDXPlus)
# بيانات DDXPlus الخام (كبيرة، لا تُرفع للـgit)
data/raw/*
!data/raw/.gitkeep
# مصفوفات الترميز المُولَّدة (قابلة لإعادة الإنتاج عبر 02_encode.ipynb)
data/processed/*
# النماذج المدرَّبة
models/*.pkl
models/*.joblib
models/*.npz
!models/.gitkeep

# Legacy MARBERT NER weights — the model was removed with the migration to
# the LLM-first clinical interview. Kept ignored so any leftover local copy
# (app/models/marbert-ner/, ~1.3 GB) can never be committed by accident.
app/models/

# Environment
.env
.env.*
.env.local
.env.production
app/.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
logs/

docs/*
notebooks/*
!notebooks/01_explore.ipynb
!notebooks/02_encode.ipynb
!notebooks/03_train.ipynb
!notebooks/04_smart_selection.ipynb
!notebooks/05_finalize.ipynb
!notebooks/06_demo.ipynb
