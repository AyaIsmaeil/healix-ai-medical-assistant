# ============================================
# Healix - Git Ignore
# ============================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# Virtual Environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files
data/*.csv
data/*.xlsx
data/*.json
!data/category_info.json
app/data/**/*.csv
app/data/**/*.xlsx
app/data/**/*.json
app/data/**/*.m4a
!app/data/category_info.json

# Model files
models/*.bin
models/*.pt
models/marbert_model/
!models/marbert_model/category_info.json

# Trained MARBERT NER weights (large — keep out of git)
*.safetensors
app/models/marbert-ner/

# Environment
.env
.env.local
.env.production
app/.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
logs/

docs/*
