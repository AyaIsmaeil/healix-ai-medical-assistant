# ============================================
# Healix - Git Ignore
# ============================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
*.log

# Virtual Environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Data files
data/*.csv
data/*.xlsx
data/*.json
!data/category_info.json
app/data/**/*.csv
app/data/**/*.xlsx
app/data/**/*.json
app/data/**/*.m4a
app/data/**/*.parquet
!app/data/category_info.json

# Model files (local weight artifacts must never enter git)
models/*.bin
models/*.pt
*.safetensors

# ML pipeline (DDXPlus)
# بيانات DDXPlus الخام (كبيرة، لا تُرفع للـgit)
data/raw/*
!data/raw/.gitkeep
# مصفوفات الترميز المُولَّدة (قابلة لإعادة الإنتاج عبر 02_encode.ipynb)
data/processed/*
# النماذج المدرَّبة
models/*.pkl
models/*.joblib
models/*.npz
!models/.gitkeep
# label_encoder صغير جداً (~1.6KB، ليس "وزن نموذج") ومطلوب لتشغيل
# MLDiseasePredictor محلياً بلا data/ (junction على جهاز واحد فقط) — يُستثنى
# صراحةً من استبعاد *.joblib أعلاه ليصل لأي متعاون آخر عبر git.
!models/label_encoder.joblib

# Legacy MARBERT NER weights — the model was removed with the migration to
# the LLM-first clinical interview. Kept ignored so any leftover local copy
# (app/models/marbert-ner/, ~1.3 GB) can never be committed by accident.
app/models/

# Offline training workspace (large, reproducible from the notebooks) — the
# regenerated train/test matrices (~446 MB) and the trained .pkl (~13 MB) must
# never enter git. The notebooks/ and *.py under training/ ARE tracked (code);
# only the heavy generated artifacts are excluded.
training/data/
training/models/*.pkl
training/models/*.joblib
training/models/*.npz

# Environment
.env
.env.*
.env.local
.env.production
app/.env

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
logs/

# RAG knowledge base (generated by harvest_medical_data.py)
knowledge_base/chroma/
knowledge_base/raw_pubmed/
knowledge_base/extracted/
knowledge_base/markdown/
knowledge_base/manifest.json
!knowledge_base/.gitkeep

docs/*
# All .md files
!docs/*.md
AI_MEDICAL_ASSISTANT_DOCUMENTATION.md
ابدأ_هنا.md
المراحل_والتقنيات.md
