# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- api/main.py: POST /chat auth (required) ---
# Shared secret Laravel sends back in the X-Healix-Internal-Token header
# on every POST /chat call (CLAUDE.md > Architecture: "Internal network +
# shared secret in header" — this service is not internet-facing).
# api/main.py's own lifespan refuses to start at all if this is unset,
# same "no silent fallback" discipline as every other required setting
# in this file — there is no unauthenticated mode. Generate a real value
# with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# and keep it in sync with whatever Laravel is configured to send.
HEALIX_INTERNAL_TOKEN=

# --- Provider credentials (required) ---
# Only required for tiers configured to use that provider — see
# HEALIX_LLM_PROVIDER_FAST / HEALIX_LLM_PROVIDER_QUALITY below.
#
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq console API key: https://console.groq.com/keys
GROQ_API_KEY=
# Local Ollama server — no API key (nothing to protect), but the base URL
# is still required explicitly, same as every other provider setting in
# this file. Standard local default shown; only change this if your
# Ollama install listens elsewhere.
OLLAMA_BASE_URL=http://localhost:11434

# --- Provider per tier (required) ---
# CLAUDE.md > Conventions: provider switching happens in llm_client.py alone.
# Each tier picks its provider independently — fast and quality do not have
# to match. Supported values: gemini | groq | ollama.
HEALIX_LLM_PROVIDER_FAST=gemini
HEALIX_LLM_PROVIDER_QUALITY=gemini

# --- Models per tier (required) ---
# CLAUDE.md > LLM tiers. Free-tier providers only.
#   fast    — symptom extraction, follow-up phrasing (high frequency, low stakes)
#   quality — red flags, crisis check, diagnosis, reports (low frequency, high stakes)
# Model names are configuration, never hardcoded: llm_client raises
# LLMConfigError if either is unset. Must match the tier's provider above.
#
# *** HEALIX_LLM_PROVIDER_QUALITY MUST NEVER BE ollama. ***
# Manually tested (scripts/try_crisis_manually.py) on the same real crisis
# message against both: Ollama/qwen3:4b returned is_crisis=False (missed
# it); Gemini (gemini-3.1-flash-lite) returned is_crisis=True with an
# appropriate response. This is not a structured-output or latency
# concern — those are fine on Ollama (see below) — it is qwen3:4b simply
# not being reliable enough at crisis detection specifically, which is
# the least acceptable place to be wrong (CLAUDE.md > LLM tiers). Ollama
# is for bulk/English-language work only: the fast tier, and standalone
# scripts like scripts/filter_columbia_symptoms.py — never the quality
# tier, and never anything on the crisis or red-flag path.
#
# *** If a tier's provider is groq AND that tier is ever called with a
# schema (call_llm(..., schema=...)), its model MUST be one of the two Groq
# has verified strict structured-output support for: openai/gpt-oss-20b or
# openai/gpt-oss-120b. Any other Groq model + schema combination is refused
# by llm_client before the request is sent — see llm_client._GroqProvider
# and scripts/verify_groq_enum.py. This project has both fast and quality
# tiers calling schema-constrained prompts, so a Groq-backed tier needs one
# of these two models, not a general-purpose Groq model like llama-3.3. ***
#
# *** Gemini model names shift. gemini-2.5-flash (this file's value until
# now) already returns 404 on the current API key — the whole 2.5 family
# is being deprecated. gemini-3.1-flash-lite below is what replaced it,
# confirmed working. If ANY Gemini call starts 404ing, that is the first
# thing to suspect again, not a code bug: re-list what's actually
# available for your key before guessing at a new name —
#     from google import genai
#     for m in genai.Client(api_key=...).models.list(): print(m.name)
# — and update both lines below (and llm_client's docs/tests that name a
# model) to whatever is current. This has already happened once. ***
HEALIX_MODEL_FAST=gemini-3.1-flash-lite
HEALIX_MODEL_QUALITY=gemini-3.1-flash-lite
# Groq equivalents, if HEALIX_LLM_PROVIDER_* above is groq instead:
#   HEALIX_MODEL_FAST=openai/gpt-oss-20b
#   HEALIX_MODEL_QUALITY=openai/gpt-oss-120b
# Ollama equivalent for the FAST tier ONLY (see the quality-tier warning
# above) — not model-gated like Groq (structured output is enforced
# beneath the model, via llama.cpp's grammar system, not by the model
# itself), so any model your local Ollama has pulled works, e.g.:
#   HEALIX_MODEL_FAST=qwen3:4b
# This project's own working setup, as of this writing:
#   HEALIX_LLM_PROVIDER_FAST=ollama       + HEALIX_MODEL_FAST=qwen3:4b
#   HEALIX_LLM_PROVIDER_QUALITY=gemini    + HEALIX_MODEL_QUALITY=gemini-3.1-flash-lite

# --- Retry behaviour (optional; defaults shown) ---
# Total attempts per call, including the first. Transient provider failures
# (rate limit, timeout, 5xx) are retried; schema validation failures never are.
HEALIX_LLM_MAX_ATTEMPTS=4
# Exponential backoff with full jitter: delay ~ U(0, min(cap, base * 2^(n-1)))
HEALIX_LLM_BACKOFF_BASE_SECONDS=0.5
HEALIX_LLM_BACKOFF_CAP_SECONDS=8.0

# Timeout applied to each individual provider attempt, in seconds. A timeout
# is transient and is retried. This bounds one attempt, NOT the whole call —
# the total budget below is what bounds the call.
HEALIX_LLM_TIMEOUT_SECONDS=30

# Hard wall-clock ceiling for a single call_llm: all attempts plus all
# backoff sleeps. When less than this remains, the next attempt is given the
# remainder instead of the full per-attempt timeout, so no attempt can
# outlive the call. On exhaustion, LLMUnavailable says "exhausted its Ns
# total budget" rather than "failed after N attempts" — the two mean
# different things and want different fixes.
#
# *** THIS MUST STAY BELOW LARAVEL'S HTTP CLIENT TIMEOUT ***
#
#   HEALIX_LLM_TOTAL_BUDGET_SECONDS  <  Laravel HTTP client timeout
#
# The relationship, so whoever tunes one knows to check the other:
#   - Laravel calls this service over HTTP and gives up after its own
#     timeout. If our budget is the larger number, Laravel disconnects
#     first and this service keeps burning quota on a request nobody is
#     waiting for — the patient sees an error while the work continues.
#   - Leave headroom: one graph turn may make MORE THAN ONE call_llm
#     (e.g. crisis check, then extraction, then red flags). Laravel's
#     timeout must cover the whole turn, not one call. Budget accordingly:
#     Laravel timeout > (calls per turn x this budget) + overhead.
#   - Raising MAX_ATTEMPTS or TIMEOUT does NOT extend this ceiling; the
#     budget wins. To actually allow more retry time, raise this — and
#     then re-check the Laravel side.
#
# Note the shipped defaults: 25s budget is BELOW the 30s per-attempt
# timeout, so out of the box the budget is the binding limit and a first
# attempt is given 25s, not 30s. That is intentional — the call-level
# ceiling should be what you reason about, not the per-attempt one.
HEALIX_LLM_TOTAL_BUDGET_SECONDS=25

# *** IF A TIER USES ollama (local inference), THE DEFAULTS ABOVE ARE
# LIKELY TOO TIGHT — raise both in this file, not in code. ***
#
# Measured directly on a 4GB GPU (qwen3:4b, ollama 0.32.5), not assumed: a
# genuine cold start (model not resident in VRAM — happens whenever it's
# been idle past Ollama's own keep_alive window) took 20.0s total for a
# realistic ~2900-char prompt: 7.2s loading the model into VRAM + 8.5s
# prompt evaluation + 4.2s generation. That leaves the 25s default budget
# almost no margin — a single retry after any transient failure on the
# first attempt would have under 5s left, below the 12s floor
# (llm_client._MIN_ATTEMPT_TIMEOUT_SECONDS) below which an attempt isn't
# even tried, so the call would exhaust its budget without ever getting a
# retry. A warm model is fast (~2s for a schema-constrained call, since
# thinking is suppressed — see llm_client._OllamaProvider); it is
# specifically a cold start, or a longer prompt than tested here (a fuller
# multi-turn conversation, not one short message), that needs the room.
# Recommended when a tier is on ollama:
#   HEALIX_LLM_TIMEOUT_SECONDS=40
#   HEALIX_LLM_TOTAL_BUDGET_SECONDS=60
# These are global, not per-provider, so if any tier is on a cloud
# provider in the same deployment, raising them costs that tier nothing
# but slightly more patience before it gives up on a truly dead request.

# --- Conversation-memory checkpointer (graph.build_checkpointer) ---
# Either/or, not a fallback chain: PostgresSaver if HEALIX_POSTGRES_DSN is
# set, otherwise SqliteSaver. If it's set and the connection fails, that
# failure surfaces — it never silently degrades to local SQLite (same
# "no silent fallback" reasoning as provider selection above). Leaving
# this unset is a deliberate choice too: local development mode, not an
# accident, and graph.py logs which one it picked on every startup so
# that's never ambiguous from the logs alone.
#
# Postgres connection string, e.g.:
#   postgresql://user:password@host:5432/healix
# Unset by default — local dev runs on SQLite instead.
HEALIX_POSTGRES_DSN=

# Only read when HEALIX_POSTGRES_DSN above is unset. Relative paths are
# resolved against the process's working directory. Optional — defaults
# to healix_checkpoints.sqlite (graph._DEFAULT_SQLITE_PATH) if unset.
HEALIX_SQLITE_PATH=
